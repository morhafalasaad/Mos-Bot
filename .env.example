# =============================================================================
# mos-bot — environment variable template
# =============================================================================
# Local use:   cp .env.example .env   then fill in the real values below.
#              (.env is git-ignored — never commit real secrets.)
# Render etc.: do NOT upload .env. Add each variable you need under the
#              platform's "Environment Variables" UI instead.
#
# Format notes (read by python-dotenv):
#   - One KEY=value per line, no spaces around "=".
#   - Do NOT wrap values in quotes — especially in GEMINI_API_KEYS, where
#     quotes around each key are a common paste mistake.
#   - Lines starting with "#" are comments. Optional settings below are
#     commented out and show their built-in DEFAULT; uncomment and edit
#     only the ones you want to change.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the bot refuses to start if any of these four is missing
# -----------------------------------------------------------------------------

# Gemini API key(s) from https://aistudio.google.com/app/apikey
# Comma-separated list, no spaces/quotes. Multiple keys are rotated
# automatically when one hits its quota, so adding more keys raises your
# effective daily request budget.
#   GEMINI_API_KEYS=key_one,key_two,key_three
# (The older single-key GEMINI_API_KEY is still honored if
# GEMINI_API_KEYS is unset, but then there is no rotation.)
GEMINI_API_KEYS=

# Telegram bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=

# The chat that receives notifications. Message your bot once, then open
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# and copy the numeric "chat":{"id": ...} value. Only messages from this
# chat are accepted by the Reply Assistant / feedback buttons.
TELEGRAM_CHAT_ID=

# MongoDB Atlas connection string (the free M0 tier is enough). Holds ALL
# persistent state — seen projects, score cache, retry queue, daily request
# counter, repost history, win/loss outcomes — so it survives restarts and
# redeploys. In Atlas: Database -> Connect -> Drivers -> copy the
# "mongodb+srv://..." string, replace <password>, and allow your host's IP
# under Network Access.
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=


# -----------------------------------------------------------------------------
# OPTIONAL — matching / scraping
# -----------------------------------------------------------------------------

# Comma-separated skill list. FULLY REPLACES the built-in default list in
# config.py when set (it is not additive). Include English AND Arabic terms,
# because Mostaql tags and titles use both. Used for the local pre-filter
# and in the scoring prompt. Takes effect on the next restart.
#   MY_SKILLS=Python,بايثون,React,ريأكت,WordPress,ووردبريس
# MY_SKILLS=

# Minimum match score (0-100) a project must reach before a proposal is
# drafted and sent to Telegram. Raise it to be more selective.
# (The effective threshold can climb above this under quota pressure — see
# ADAPTIVE_THRESHOLD_* in config.py.)
# MATCH_THRESHOLD=60

# Comma-separated Mostaql category slugs to scrape instead of the single
# unfiltered listing, e.g. python,data-science,machine-learning
# Leave blank to scrape the default listing page. The URL pattern used is
# MOSTAQL_CATEGORY_URL_TEMPLATE in config.py — verify it against the live
# site if you enable this.
# MOSTAQL_CATEGORIES=

# How often to poll Mostaql, in seconds (a random value between the two is
# used each cycle).
# POLL_INTERVAL_MIN=300
# POLL_INTERVAL_MAX=420


# -----------------------------------------------------------------------------
# OPTIONAL — Gemini
# -----------------------------------------------------------------------------

# Route ONLY Gemini traffic through a proxy (everything else — Mostaql,
# Telegram, GitHub — stays direct). Needed only if Gemini rejects your
# location with "User location is not supported". Examples:
#   GEMINI_PROXY_URL=http://user:pass@host:port
#   GEMINI_PROXY_URL=socks5://user:pass@host:port   (needs httpx[socks])
# GEMINI_PROXY_URL=

# Rough total requests/day across ALL keys, used only by the adaptive
# threshold. Default = 500 x number of keys (sized for the primary
# "-lite" models in the cascade). Lower it if your tier is smaller.
# GEMINI_ESTIMATED_DAILY_QUOTA=


# -----------------------------------------------------------------------------
# OPTIONAL — GitHub fallback record
# -----------------------------------------------------------------------------
# When Gemini is unavailable, the bot can ALSO open a human-readable GitHub
# Issue with the project's details. Purely a convenience record — the real
# retry queue lives in MongoDB. Enabled only when BOTH values are set. Use a
# SEPARATE repo from this one, so nothing here can trigger a redeploy.

# Fine-grained personal access token with Issues (and Contents, for
# file mode) write access to GITHUB_REPO.
# GITHUB_TOKEN=

# "owner/repo" of the repository that should receive the issues.
# GITHUB_REPO=owner/mos-bot-fallback


# -----------------------------------------------------------------------------
# OPTIONAL — Reply Assistant
# -----------------------------------------------------------------------------
# Paste a client's message into the bot's Telegram chat and it suggests
# several reply options. Set to false to disable the second Telegram
# listener entirely.
# REPLY_ASSISTANT_ENABLED=true
